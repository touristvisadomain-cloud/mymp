{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "24",
    "pnpm": "12.3.4"
  },
  "steps": {
    "install-sangsad": {
      "commands": ["cd sangsad && pnpm install --frozen-lockfile"]
    },
    "build": {
      "commands": ["npm run build"]
    }
  },
  "secrets": [
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "DATABASE_URL",
    "DATABASE_SSL",
    "DATABASE_SCHEMA",
    "ADMIN_BOOTSTRAP_EMAIL",
    "DOKPLOY_DEPLOY_WEBHOOK",
    "CRON_SECRET",
    "APP_ENV",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "NEWS_AUTO_PUBLISH",
    "SCRAPER_USER_AGENT",
    "CHROME_PATH",
    "OG_CARDS_ALL",
    "WIKI_CACHE_DIR",
    "FEED_SEARCH_KEY",
    "FEED_SEARCH_PROVIDER",
    "FEED_SEARCH_CX",
    "FEED_SEARCH_PER_RUN",
    "YOUTUBE_API_KEY",
    "YOUTUBE_MEMBERS_PER_RUN",
    "YOUTUBE_CHANNELS_PER_RUN"
  ],
  "deploy": {
    "startCommand": "npx next start",
    "variables": {
      "NODE_ENV": "production",
      "NEXT_TELEMETRY_DISABLED": "1",
      "HOSTNAME": "0.0.0.0",
      "PORT": "3000"
    }
  }
}
