{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "24",
    "pnpm": "12.3.4"
  },
  "steps": {
    "install": {
      "commands": ["pnpm install --frozen-lockfile"]
    }
  },
  "secrets": [
    "DATABASE_URL",
    "DATABASE_SSL",
    "DATABASE_SCHEMA",
    "SANGSAD_SUPABASE_URL",
    "SANGSAD_SUPABASE_SERVICE_ROLE_KEY",
    "SANGSAD_DATABASE_URL",
    "SANGSAD_DATABASE_SSL",
    "SANGSAD_DATABASE_SCHEMA",
    "MYMP_SUPABASE_URL",
    "MYMP_SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "MYMP_DEPLOY_TOKEN",
    "DEPLOY_REPOSITORY",
    "CRON_SECRET",
    "MYMP_INTERNAL_URL",
    "WORKER_SITE_JOBS",
    "APP_ENV"
  ],
  "deploy": {
    "startCommand": "pnpm schedule",
    "variables": {
      "NODE_ENV": "production"
    }
  }
}