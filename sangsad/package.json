{
  "name": "sangsad",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @sangsad/db generate",
    "db:migrate": "pnpm --filter @sangsad/db migrate",
    "db:seed": "pnpm --filter @sangsad/db seed",
    "worker": "pnpm --filter @sangsad/worker start",
    "job": "pnpm --filter @sangsad/worker job",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
