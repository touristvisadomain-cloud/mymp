# ---- Shared PostgreSQL database -----------------------------------------------
# MYMP keeps its tables in public; Sangsad uses the sangsad schema.
# Use DATABASE_SSL=disable for the local self-hosted plain PostgreSQL port.
# Never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@host:5432/postgres
DATABASE_SSL=require
DATABASE_SCHEMA=sangsad

# ---- Shared Supabase (Project Settings → API Keys → Legacy) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shared Supabase service key for Sangsad database/mirror writes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Fixtures (tests and local experiments only) -----------------------------
# FIXTURES=1 lets code load the TEST_-prefixed files in fixtures/. The loader
# refuses on any production deployment: VERCEL_ENV=production,
# APP_ENV=production, or NEXT_PUBLIC_SITE_URL on mymp.bd.
FIXTURES=0
APP_ENV=development

# ---- Worker ------------------------------------------------------------------
YOUTUBE_API_KEY=
# 1 request per second per domain is enforced in code; this only names the bot.
SCRAPER_USER_AGENT=MyMPBot/1.0 (+https://mymp.bd/somporke)
