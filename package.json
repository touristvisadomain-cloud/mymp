{
  "name": "mymp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync.mjs --soft && tsx scripts/build-name-idf.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "sync": "node scripts/sync.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "typecheck": "tsc --noEmit",
    "build:local": "next build",
    "og-image": "node scripts/og-image.mjs",
    "test": "node --import tsx --test \"src/lib/**/*.test.ts\"",
    "sync:posts": "tsx scripts/sync-posts.ts",
    "idf": "tsx scripts/build-name-idf.ts",
    "feed:seed": "tsx scripts/seed-feed.ts",
    "feed:rss": "tsx scripts/feed-collect.ts",
    "feed:rematch": "tsx scripts/feed-rematch.ts",
    "feed:prune": "tsx scripts/feed-prune.ts",
    "feed:backfill": "tsx scripts/feed-backfill.ts",
    "feed:thumbs": "tsx scripts/feed-thumbnails.ts",
    "feed:archive": "tsx scripts/feed-archive.ts"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "harfbuzzjs": "^1.6.1",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
